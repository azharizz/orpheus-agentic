AGENT_PROVIDER_URL=https://openrouter.ai/api/v1/chat/completions
AGENT_PROVIDER_API_KEY=
ORPHEUS_AUDIO_ENABLED=1
# Local defaults to OpenRouter. Cloud Run should use Vertex first and retain
# OpenRouter only as explicit failover when its key is present.
# ORPHEUS_PROVIDER_PROFILE=vertex
# ORPHEUS_VERTEX_MODEL=gemini-3.0-flash
# ORPHEUS_PROVIDER_FAILOVER=1
# Cloud Run defaults audio observation off until a configured audio provider is available.
# Optional absolute runtime storage directory; defaults to ./data
# ORPHEUS_DATA_DIR=/absolute/path/to/orpheus-data
# ORPHEUS_OBSERVABILITY_DIR=/absolute/path/to/orpheus-observability
# Optional local server port; defaults to 8766
# ORPHEUS_SERVER_PORT=8766
# Cloud Run API settings (required only when ORPHEUS_RUNTIME_MODE=cloud_run)
# ORPHEUS_RUNTIME_MODE=cloud_run
# ORPHEUS_PUBLIC_ORIGIN=https://orpheus-agentic.web.app
# ORPHEUS_ALLOWED_ORIGINS=https://orpheus-agentic.web.app
# ORPHEUS_ALLOWED_HOSTS=orpheus-agentic.web.app
# ORPHEUS_CLOUD_RUN_JOB=orpheus-worker
# ORPHEUS_SESSION_BACKEND=agent_engine
# ORPHEUS_AGENT_ENGINE_ID=REASONING_ENGINE_ID
# ORPHEUS_MEMORY_BANK=0
# GOOGLE_CLOUD_PROJECT=orpheus-agentic
# GOOGLE_CLOUD_LOCATION=us-central1
# ORPHEUS_SESSION_DATABASE_URL=postgresql+asyncpg://user:password@/orpheus?host=/cloudsql/INSTANCE_CONNECTION_NAME
# ORPHEUS_STORAGE_BACKEND=gcs
# ORPHEUS_GCS_BUCKET=orpheus-agentic-media
# ORPHEUS_METADATA_BACKEND=cloud_sql
# ORPHEUS_METADATA_DATABASE_URL=postgresql+asyncpg://user:password@/orpheus?host=/cloudsql/INSTANCE_CONNECTION_NAME
# ORPHEUS_OWNER_SECRET=long-random-secret
# Grafana Cloud writer (optional locally; hosted deployment uses Secret Manager)
# ORPHEUS_GRAFANA_TELEMETRY_TOKEN=
# ORPHEUS_GRAFANA_LOKI_URL=https://logs-prod-032.grafana.net
# ORPHEUS_GRAFANA_LOKI_USER=1777916
# ORPHEUS_GRAFANA_LOKI_DATASOURCE_UID=orpheus-loki
# ORPHEUS_GRAFANA_PROMETHEUS_DATASOURCE_UID=orpheus-prometheus
# ORPHEUS_GRAFANA_OTLP_URL=https://otlp-gateway-prod-ap-southeast-2.grafana.net
# ORPHEUS_GRAFANA_OTLP_USER=1820129
